<?xml version="1.0"?>
<sdf version="1.8">
  <model name="observation_platform">
    <pose>0 0 0 0 0 0</pose>

    <link name="hull">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <inertial>
        <mass>45</mass>
        <inertia><ixx>3.0</ixx><iyy>3.0</iyy><izz>2.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry>
      </collision>
      <visual name="hull_body">
        <geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.75 0.76 0.78 1</ambient><diffuse>0.8 0.81 0.83 1</diffuse></material>
      </visual>
      <visual name="hull_dome">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><sphere><radius>0.3</radius></sphere></geometry>
        <material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.9 0.91 0.93 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient></material>
      </visual>
      <visual name="antenna">
        <pose>0 0 1.1 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <visual name="solar_panel_left">
        <pose>0.15 0.15 0.85 0.3 0 0.785</pose>
        <geometry><box><size>0.3 0.18 0.01</size></box></geometry>
        <material><ambient>0.05 0.1 0.3 1</ambient></material>
      </visual>
      <visual name="solar_panel_right">
        <pose>-0.15 0.15 0.85 0.3 0 -0.785</pose>
        <geometry><box><size>0.3 0.18 0.01</size></box></geometry>
        <material><ambient>0.05 0.1 0.3 1</ambient></material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate><topic>imu</topic>
      </sensor>
      <sensor name="front_camera" type="camera">
        <pose>0.34 0 0.1 0 0 0</pose>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
        <always_on>true</always_on><update_rate>15</update_rate><topic>camera/image</topic>
      </sensor>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.34 0 0.05 0 0 0</pose>
        <lidar>
          <scan><horizontal><samples>180</samples><resolution>1</resolution>
            <min_angle>-1.396</min_angle><max_angle>1.396</max_angle></horizontal></scan>
          <range><min>0.2</min><max>25</max><resolution>0.05</resolution></range>
        </lidar>
        <always_on>true</always_on><update_rate>10</update_rate><topic>scan</topic>
      </sensor>
    </link>

    <link name="arm_0"><kinematic>true</kinematic><gravity>false</gravity><pose>0.40 0 0.15 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_0_joint" type="fixed"><parent>hull</parent><child>arm_0</child></joint>
    <link name="thruster_0"><kinematic>true</kinematic><gravity>false</gravity><pose>0.65 0 0.15 0 1.5708 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_0_joint" type="fixed"><parent>arm_0</parent><child>thruster_0</child></joint>

    <link name="arm_1"><kinematic>true</kinematic><gravity>false</gravity><pose>0.20 0.3464 0.15 0 0 1.047</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_1_joint" type="fixed"><parent>hull</parent><child>arm_1</child></joint>
    <link name="thruster_1"><kinematic>true</kinematic><gravity>false</gravity><pose>0.325 0.5629 0.15 0 1.5708 1.047</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_1_joint" type="fixed"><parent>arm_1</parent><child>thruster_1</child></joint>

    <link name="arm_2"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.20 0.3464 0.15 0 0 2.094</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_2_joint" type="fixed"><parent>hull</parent><child>arm_2</child></joint>
    <link name="thruster_2"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.325 0.5629 0.15 0 1.5708 2.094</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_2_joint" type="fixed"><parent>arm_2</parent><child>thruster_2</child></joint>

    <link name="arm_3"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.40 0 0.15 0 0 3.1416</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_3_joint" type="fixed"><parent>hull</parent><child>arm_3</child></joint>
    <link name="thruster_3"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.65 0 0.15 0 1.5708 3.1416</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_3_joint" type="fixed"><parent>arm_3</parent><child>thruster_3</child></joint>

    <link name="arm_4"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.20 -0.3464 0.15 0 0 4.189</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_4_joint" type="fixed"><parent>hull</parent><child>arm_4</child></joint>
    <link name="thruster_4"><kinematic>true</kinematic><gravity>false</gravity><pose>-0.325 -0.5629 0.15 0 1.5708 4.189</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_4_joint" type="fixed"><parent>arm_4</parent><child>thruster_4</child></joint>

    <link name="arm_5"><kinematic>true</kinematic><gravity>false</gravity><pose>0.20 -0.3464 0.15 0 0 5.236</pose>
      <visual name="v"><geometry><box><size>0.5 0.08 0.06</size></box></geometry>
        <material><ambient>0.05 0.2 0.45 1</ambient></material></visual></link>
    <joint name="arm_5_joint" type="fixed"><parent>hull</parent><child>arm_5</child></joint>
    <link name="thruster_5"><kinematic>true</kinematic><gravity>false</gravity><pose>0.325 -0.5629 0.15 0 1.5708 5.236</pose>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link>
    <joint name="thruster_5_joint" type="fixed"><parent>arm_5</parent><child>thruster_5</child></joint>

    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <link_name>hull</link_name>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>observation_platform/odom</odom_frame>
      <robot_base_frame>observation_platform</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
