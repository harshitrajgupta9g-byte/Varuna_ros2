      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="main"><geometry><cylinder><radius>2</radius><length>0.5</length></cylinder></geometry>
