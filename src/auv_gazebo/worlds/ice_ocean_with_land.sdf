<?xml version="1.0"?>
<sdf version="1.8">
  <world name="ice_ocean">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.45 0.50 0.60 1</ambient>
      <background>0.58 0.72 0.90 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <fog>
        <color>0.68 0.75 0.85 1</color>
        <type>linear</type>
        <start>40</start>
        <end>250</end>
      </fog>
    </scene>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 80 0 0.4 0</pose>
      <diffuse>0.95 0.95 0.98 1</diffuse>
      <specular>0.4 0.4 0.45 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <attenuation>
        <range>400</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.30 0.36 0.48 1</diffuse>
      <specular>0.04 0.05 0.08 1</specular>
      <direction>0.6 -0.4 -0.6</direction>
    </light>

    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size><segments>200 200</segments></plane></geometry>
          <material>
            <ambient>0.00 0.10 0.22 1</ambient>
            <diffuse>0.00 0.28 0.55 0.85</diffuse>
            <specular>0.85 0.95 1.00 1</specular>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.05</roughness>
              </metal>
            </pbr>
          </material>
          <transparency>0.2</transparency>
        </visual>
      </link>
    </model>

    <model name="sea_floor">
      <static>true</static>
      <pose>0 0 -15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material>
            <ambient>0.04 0.06 0.08 1</ambient>
            <diffuse>0.05 0.08 0.10 1</diffuse>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.95</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="ice_floe_1">
      <static>true</static>
      <pose>8 2 0 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.5 3.5 0.5</size></box></geometry></collision>
        <visual name="main"><geometry><box><size>4 3 0.5</size></box></geometry>
          <material><ambient>0.85 0.93 0.98 1</ambient><diffuse>0.88 0.95 1 1</diffuse>
            <pbr><metal><metalness>0.0</metalness><roughness>0.25</roughness></metal></pbr></material></visual>
        <visual name="chunk2"><pose>1.8 1.2 0.05 0.1 0.2 0.6</pose>
          <geometry><box><size>1.8 1.4 0.4</size></box></geometry>
          <material><ambient>0.82 0.9 0.96 1</ambient><diffuse>0.85 0.93 0.98 1</diffuse>
            <pbr><metal><metalness>0.0</metalness><roughness>0.3</roughness></metal></pbr></material></visual>
        <visual name="peak"><pose>0.3 0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.92 0.97 1 1</ambient><diffuse>0.95 0.99 1 1</diffuse>
            <pbr><metal><metalness>0.0</metalness><roughness>0.2</roughness></metal></pbr></material></visual>
      </link>
    </model>

